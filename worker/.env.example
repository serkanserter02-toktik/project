# ── Brick Marathon TikTok işçisi: yapılandırma ────────────────────────────────
# Çalıştırma:  node --env-file=.env index.js   (ya da platformun ortam değişkenleri)

# Kaynak: "tiktok" (gerçek) ya da "mock" (sahte hediyeler, test için)
SOURCE=mock
# Dinlenecek yayıncı (@ olmadan). SOURCE=tiktok için zorunlu.
TIKTOK_USERNAME=
# İsteğe bağlı: Euler Stream imzalama anahtarı (üretimde önerilir; kütüphane imzalama sunucusu kullanır)
TIKTOK_SIGN_API_KEY=

# ── Hedef (biri zorunlu) ─────────────────────────────────────────────────────
# A) Doğrudan Redis (önerilen: ek HTTP atlaması yok). Uygulamadaki Redis ile AYNI olmalı.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# B) ya da uygulamanın webhook'u (Redis'e yalnızca Vercel erişir)
# WEBHOOK_URL=https://<uygulama>.vercel.app/api/tiktok
# TIKTOK_WEBHOOK_SECRET=

# ── Hediye / boost kuralları (uygulama ile ortak; Redis'tekiler önceliklidir ve çalışırken yeniden okunur) ──
# Hediye ADI ülke adı olmalı: Turkey/Türkiye, USA/ABD, Russia/Rusya, Germany/Almanya, UK/England/İngiltere,
# Japan/Japonya, China/Çin, South Korea/Güney Kore. Ek eşleşmeler (JSON; değer: ülke kodu, adı ya da 1-8 numarası):
# GIFT_ALIASES={"Rose":"TR","Lion":"Russia","Galaxy":3}
# Redis'te canlı değiştirmek için:  SET config:giftAliases '{"Rose":"TR"}'
# Eşleşmeyen hediyeler: ignore (yok say, varsayılan) | user (izleyici kimliğinden sabit koşucuya ata)
# UNMATCHED_GIFTS=ignore
# Boost başına jeton (varsayılan 2). Redis: SET config:coinsPerBoost 5  (sonraki yarıştan itibaren geçerli)
# COINS_PER_BOOST=2

# ── İşçi ayarları (varsayılanlar genelde yeterli) ─────────────────────────────
# FLUSH_MS=500          # toplu gönderim aralığı
# MAX_BATCH=200         # istek başına olay (en çok 200)
# MAX_QUEUE=5000        # bellek sınırı; aşılırsa en eski olaylar atılır
# OFFLINE_RETRY_MS=30000 # yayıncı yayında değilken yeniden deneme aralığı
# PORT=8080             # /healthz (0 = kapalı)
# MOCK_RATE=3           # SOURCE=mock: saniyede ortalama hediye
# LOG_LEVEL=info        # error | warn | info | debug
